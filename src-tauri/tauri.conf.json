{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPUCompact",
  "version": "1.0.0",
  "identifier": "com.udpsendtofailed.gpucompact",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GPUCompact (.gcmp)",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "gpucompact_native.dll",
      "gpucompact.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["gcmp"],
        "name": "GPUCompact Archive",
        "description": "GPUCompact CUDA Compressed Archive",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  }
}
